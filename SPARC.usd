            double3 xformOp:translate = (0.48901382116144765, -0.26249891093053457, -0.05952813317078265)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZYX", "xformOp:scale", "xformOp:rotateX:unitsResolve"]

